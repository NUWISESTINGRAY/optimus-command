{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://aguamdcgtthxoaccjjou.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "optimus-mcp",
      "version": "0.1.0",
      "title": "OPTIMUS AI OS"
    },
    "tools": [
      {
        "name": "list_tasks",
        "title": "List tasks",
        "description": "List OPTIMUS mission-queue tasks for the signed-in user. Optional status filter (todo, in_progress, done).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Optional status filter",
              "type": "string"
            },
            "limit": {
              "description": "Max rows (default 25)",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "create_task",
        "title": "Create task",
        "description": "Create a task in the OPTIMUS mission queue for the signed-in user.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "description": "Task title"
            },
            "description": {
              "description": "Longer description",
              "type": "string"
            },
            "priority": {
              "description": "Priority (default medium)",
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high"
              ]
            },
            "due_date": {
              "description": "Due date (ISO 8601)",
              "type": "string"
            },
            "assignee": {
              "description": "Assignee name or agent codename",
              "type": "string"
            }
          },
          "required": [
            "title"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_agents",
        "title": "List agents",
        "description": "List the JW Brand AI team roster (17 executive and specialist agents).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_pending_approvals",
        "title": "List pending approvals",
        "description": "List pending items in the OPTIMUS Approval Gate for the signed-in user.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Max rows (default 20)",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
